# Required. Free key, no card: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=...

# Required for stays, fares and activities. Weather and photos need no key.
# Free key, 250 searches/month: https://serpapi.com/users/sign_up
SERPAPI_KEY=...

# Optional alternative vendor for stays and fares only: https://api.scrapingdog.com/register
# Activities still need SERPAPI_KEY, and its fares are one-way.
# SCRAPINGDOG_KEY=...
# SERP_VENDOR=scrapingdog

# Optional. Defaults below. gemini-2.5-flash and older are not available to new keys.
# TRAVEL_AGENT_MODEL=gemini-3.6-flash
# TRAVEL_AGENT_FAST_MODEL=gemini-flash-lite-latest

# Optional. Where climate normals are cached between restarts, so they are fetched once.
# WEATHER_NORMALS_CACHE=.cache/weather-normals.json
