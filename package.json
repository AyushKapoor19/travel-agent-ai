{
  "name": "travel-agent-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deadcode": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx --env-file-if-exists=.env.local --conditions=react-server evals/extraction.eval.ts",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run deadcode && npm run test"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.118",
    "@ai-sdk/react": "^3.0.274",
    "ai": "^6.0.271",
    "gsap": "^3.15.0",
    "motion": "^13.1.1",
    "next": "15.5.24",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "0.0.1",
    "three": "^0.185.1",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "eslint": "^9",
    "eslint-config-next": "15.5.24",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "knip": "^5.88.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "tsx": "4.23.13",
    "typescript": "^5",
    "vitest": "4.1.11"
  }
}
